#include <Wire.h>
#include <HX711.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64

Adafruit_SSD1306 display(
SCREEN_WIDTH,
SCREEN_HEIGHT,
&Wire,
-1);

#define DT_PIN 19
#define SCK_PIN 18

#define TARE_BUTTON 25
#define BUZZER_PIN 26

HX711 scale;

float calibration_factor = 420;
float batas_aman = 250.0;

void setup()
{
Serial.begin(115200);

pinMode(TARE_BUTTON, INPUT_PULLUP);

pinMode(BUZZER_PIN, OUTPUT);
digitalWrite(BUZZER_PIN, LOW);

Wire.begin(21,22);

if(!display.begin(
SSD1306_SWITCHCAPVCC,
0x3C))
{
Serial.println("OLED gagal");
while(1);
}

display.clearDisplay();

display.setTextColor(WHITE);

display.setTextSize(2);
display.setCursor(0,0);
display.println("URICARE");
display.display();

delay(2000);

scale.begin(DT_PIN,SCK_PIN);

scale.set_scale(calibration_factor);

scale.tare();
}

void loop()
{

float berat = scale.get_units(10);

if(berat < 0)
{
berat = 0;
}

if(digitalRead(TARE_BUTTON)==LOW)
{
scale.tare();

display.clearDisplay();

display.setTextSize(2);
display.setCursor(0,20);
display.println("TARE");

display.display();

delay(1000);
}

display.clearDisplay();

display.setTextSize(1);
display.setCursor(0,0);
display.println("TIMBANGAN URICARE");

display.setTextSize(3);
display.setCursor(0,18);
display.print(berat,1);
display.print("g");

display.setTextSize(1);
display.setCursor(0,55);

if(berat <= batas_aman)
{
display.print("Kategori : AMAN");

digitalWrite(BUZZER_PIN,LOW);
}
else
{
display.print("Kategori : BAHAYA");

tone(BUZZER_PIN,2000);
delay(200);
noTone(BUZZER_PIN);
}

display.display();

Serial.print("Berat : ");
Serial.println(berat);

delay(300);
}
